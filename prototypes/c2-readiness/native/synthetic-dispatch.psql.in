BEGIN READ WRITE;
SELECT 1 / (pg_backend_pid()=@@PID@@ AND (SELECT backend_start FROM pg_stat_activity WHERE pid=pg_backend_pid())=@@BACKEND_START@@::timestamptz AND (SELECT system_identifier::text FROM pg_control_system())=@@CLUSTER@@ AND clock_timestamp()<@@DEADLINE@@::timestamptz)::int;
CREATE TEMP TABLE c2_native_synthetic(value integer NOT NULL) ON COMMIT DROP;
INSERT INTO c2_native_synthetic VALUES (42);
SELECT 1 / (count(*)=1 AND sum(value)=42)::int FROM c2_native_synthetic;
COMMIT;
SELECT 'NATIVE_COMMIT_RECEIPT|' || jsonb_build_object('backend',@@IDENTITY@@,'operation_hash',@@OPERATION_HASH@@,'postconditions',true)::text;
